{
    "name": "live-lexxy",
    "version": "0.1.0",
    "description": "A modern rich text editor component for Laravel Livewire",
    "main": "resources/js/live-lexxy.js",
    "scripts": {
        "build": "npm run build:js && npm run build:css",
        "build:js": "esbuild resources/js/live-lexxy.js --bundle --minify --outfile=dist/live-lexxy.min.js",
        "build:css": "cp resources/css/live-lexxy.css dist/live-lexxy.min.css",
        "dev": "npm run build:js -- --watch"
    },
    "keywords": [
        "laravel",
        "livewire",
        "editor",
        "lexical"
    ],
    "author": "Andreas Kviby",
    "license": "MIT",
    "dependencies": {
        "lexical": "^0.22.0",
        "@lexical/clipboard": "^0.22.0",
        "@lexical/code": "^0.22.0",
        "@lexical/history": "^0.22.0",
        "@lexical/html": "^0.22.0",
        "@lexical/link": "^0.22.0",
        "@lexical/list": "^0.22.0",
        "@lexical/markdown": "^0.22.0",
        "@lexical/plain-text": "^0.22.0",
        "@lexical/rich-text": "^0.22.0",
        "@lexical/selection": "^0.22.0",
        "@lexical/table": "^0.22.0",
        "@lexical/utils": "^0.22.0",
        "dompurify": "^3.0.0",
        "prismjs": "^1.29.0"
    },
    "devDependencies": {
        "esbuild": "^0.20.0"
    }
}
